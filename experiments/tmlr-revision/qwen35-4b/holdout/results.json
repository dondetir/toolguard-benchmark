  "policy": {
    "train_policy": "configs/defense_policy_train.yaml",
    "removals_from_full_policy": [
      {
        "rule": "block_sql_injection",
        "element": "alter\\s+table",
        "reason": "Only motivated by db_schema_modification (test set)"
      },
      {
        "rule": "block_dangerous_commands",
        "element": "chmod",
        "reason": "Only motivated by fs_chmod_via_write (test set); note: rule only applies to run_command, not write_file, so this entry had zero practical effect in the full policy anyway"
      },
      {
        "rule": "block_dangerous_commands",
        "element": "backdoor",
        "reason": "Only motivated by sys_add_user (test set) which calls run_command('useradd ... backdoor')"
      }
    ]
  },
